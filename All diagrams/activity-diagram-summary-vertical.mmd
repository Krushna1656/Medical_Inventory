%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Calibri, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#ffffff",
    "secondaryColor": "#ffffff",
    "tertiaryColor": "#ffffff",
    "primaryTextColor": "#1f1f1f",
    "primaryBorderColor": "#7f7f7f",
    "lineColor": "#7f7f7f"
  },
  "flowchart": {
    "useMaxWidth": false,
    "nodeSpacing": 34,
    "rankSpacing": 42,
    "curve": "linear"
  }
}}%%
flowchart TD
    start([Start]) --> launch[Open<br/>MediCore]
    launch --> account{Admin account<br/>exists?}
    account -- No --> register[Register admin<br/>account]
    account -- Yes --> login[Enter username<br/>and password]
    register --> login
    login --> valid{Credentials<br/>valid?}
    valid -- No --> retry[Show error and<br/>retry login]
    retry --> login
    valid -- Yes --> dashboard[Open<br/>dashboard]
    dashboard --> work[Manage modules<br/>Inventory, Stock,<br/>Reports, Settings]
    work --> refresh[Refresh tables<br/>and statistics]
    refresh --> logout{Log out?}
    logout -- No --> work
    logout -- Yes --> finish([End])

    classDef terminal fill:#ffffff,stroke:#7f7f7f,stroke-width:1.2px,color:#1f1f1f,font-family:Calibri,Arial,sans-serif,font-size:15px;
    classDef process fill:#ffffff,stroke:#7f7f7f,stroke-width:1.2px,color:#1f1f1f,font-family:Calibri,Arial,sans-serif,font-size:15px;
    classDef decision fill:#ffffff,stroke:#7f7f7f,stroke-width:1.2px,color:#1f1f1f,font-family:Calibri,Arial,sans-serif,font-size:15px;

    class start,finish terminal;
    class launch,register,login,retry,dashboard,work,refresh process;
    class account,valid,logout decision;

    linkStyle default stroke:#7f7f7f,stroke-width:1.2px,fill:none;
