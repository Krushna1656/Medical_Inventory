sequenceDiagram
    actor Admin
    participant App as MediCore<br/>System
    participant DB as Database

    Admin->>App: Submit stock<br/>transaction
    App->>App: Validate input

    alt Invalid input
        App-->>Admin: Show validation<br/>error
    else Valid input
        App->>DB: Check medicine and<br/>current stock

        alt Medicine missing or<br/>stock too low
            DB-->>App: Reject update
            App-->>Admin: Show failure<br/>message
        else Update allowed
            App->>DB: Save stock update
            DB-->>App: Commit changes
            App-->>Admin: Show updated<br/>inventory
        end
    end
